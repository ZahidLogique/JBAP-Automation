{
  "name": "jbap",
  "version": "1.0.0",
  "description": "JBAP QA Automation",
  "scripts": {
    "pretest": "node scripts/allure-env.js && node scripts/allure-categories.js",
    "test": "playwright test",
    "test:backoffice": "playwright test --project=backoffice",
    "test:e2e": "playwright test --project=backoffice-e2e --project=auction --project=e2e-cleanup",
    "test:auction": "playwright test --project=auction",
    "posttest": "allure generate allure-results -o allure-report --clean",
    "report": "allure generate allure-results -o allure-report --clean && allure open allure-report",
    "report:serve": "allure serve allure-results"
  },
  "devDependencies": {
    "@playwright/cli": "^0.1.17",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "dotenv": "^17.4.2",
    "playwright": "^1.62.0",
    "playwright-core": "^1.62.0",
    "typescript": "^7.0.2"
  }
}
